<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FixMaster.ViewModels"
             xmlns:login="using:FixMaster.Views.Login"
             xmlns:shell="using:FixMaster.Views.Shell"
             x:Class="FixMaster.App">

    <Application.DataTemplates>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <login:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShellViewModel}">
            <shell:ShellView />
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://FixMaster/Themes/StarfieldStyles.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://FixMaster/Themes/Colors.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
