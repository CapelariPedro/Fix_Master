<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FixMaster.ViewModels"
             x:Class="FixMaster.Views.Login.PrimeiroAcessoView"
             x:DataType="vm:PrimeiroAcessoViewModel"
             FontFamily="Futura, Jost, Century Gothic, Segoe UI">

    <Grid>
        <Border Width="400"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource SwPanelBrush}"
                BorderBrush="{DynamicResource SwMidBrush}" BorderThickness="1"
                BoxShadow="0 10 30 0 #55000000">
            <StackPanel>
                <Border Background="{DynamicResource SwBarBrush}" Padding="20,10">
                    <TextBlock Text="CONFIGURAÇÃO INICIAL"
                               FontSize="12" FontWeight="SemiBold"
                               LetterSpacing="4" Foreground="#E8E8EA"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Spacing="18" Margin="28,24,28,28">
                    <Image Source="avares://FixMaster/Assets/logos/logo_vb_preto_branco.ico"
                           Width="72" Height="72" Stretch="Uniform"
                           HorizontalAlignment="Center" />

                    <TextBlock Classes="sw-label" Text="CRIE A CONTA DE ADMINISTRADOR"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Essa conta será usada para administrar o sistema."
                               HorizontalAlignment="Center" FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SwMidBrush}" />

                    <StackPanel Spacing="4">
                        <TextBlock Classes="sw-label" Text="USUÁRIO" />
                        <TextBox Classes="sw-input"
                                 Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Digite seu usuário"
                                 MinHeight="42" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="sw-label" Text="SENHA" />
                        <TextBox Classes="sw-input"
                                 Text="{Binding Senha, UpdateSourceTrigger=PropertyChanged}"
                                 PasswordChar="●"
                                 PlaceholderText="Mínimo de 8 caracteres"
                                 MinHeight="42" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="sw-label" Text="CONFIRMAR SENHA" />
                        <TextBox Classes="sw-input"
                                 Text="{Binding ConfirmarSenha, UpdateSourceTrigger=PropertyChanged}"
                                 PasswordChar="●"
                                 PlaceholderText="Repita a senha"
                                 MinHeight="42" />
                    </StackPanel>

                    <TextBlock Text="{Binding MensagemErro}"
                               IsVisible="{Binding MensagemErro, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{DynamicResource SfDangerBrush}"
                               TextWrapping="Wrap" />

                    <Button Classes="sw-accent" Content="CRIAR CONTA"
                            Command="{Binding CriarCommand}"
                            IsDefault="True"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            MinHeight="46" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
