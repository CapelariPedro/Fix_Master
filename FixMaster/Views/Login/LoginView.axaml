<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FixMaster.ViewModels"
             x:Class="FixMaster.Views.Login.LoginView"
             x:DataType="vm:LoginViewModel">
    <Grid>
        <StackPanel Width="380"
                    Spacing="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Image Source="avares://FixMaster/Assets/logos/logo_vb_colorido.png"
                   Height="112"
                   Stretch="Uniform" />

            <Border Classes="panel" Padding="28">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="FIXMASTER"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Classes="muted"
                                   Text="Acesse sua conta para continuar"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="label" Text="USUÁRIO" />
                        <TextBox Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Digite seu usuário"
                                 MinHeight="42" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="label" Text="SENHA" />
                        <TextBox Text="{Binding Senha, UpdateSourceTrigger=PropertyChanged}"
                                 PasswordChar="●"
                                 PlaceholderText="Digite sua senha"
                                 MinHeight="42" />
                    </StackPanel>

                    <TextBlock Text="{Binding MensagemErro}"
                               IsVisible="{Binding MensagemErro, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{DynamicResource SfDangerBrush}"
                               TextWrapping="Wrap" />

                    <Button Classes="accent"
                            Content="ENTRAR"
                            Command="{Binding EntrarCommand}"
                            IsDefault="True"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            MinHeight="44" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
