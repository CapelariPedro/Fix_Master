<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FixMaster.ViewModels"
        x:Class="FixMaster.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="FixMaster"
        Icon="/Assets/logos/logo_vb_colorido.ico"
        Width="960"
        Height="640"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SfBgBrush}">
    <ContentControl Content="{Binding CurrentScreen}" />
</Window>
