<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cores principais -->
    <Color x:Key="BgColor">#0F141B</Color>
    <Color x:Key="SurfaceColor">#1A222D</Color>
    <Color x:Key="AccentColor">#9FB3C8</Color>
    <Color x:Key="TextColor">#FFFFFF</Color>
    <Color x:Key="SecondaryTextColor">#A0AAB5</Color>
    <Color x:Key="BorderColor">#303B49</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgBrush"
                     Color="{StaticResource BgColor}" />

    <SolidColorBrush x:Key="SurfaceBrush"
                     Color="{StaticResource SurfaceColor}" />

    <SolidColorBrush x:Key="AccentBrush"
                     Color="{StaticResource AccentColor}" />

    <SolidColorBrush x:Key="TextBrush"
                     Color="{StaticResource TextColor}" />

    <SolidColorBrush x:Key="SfBgBrush"
                     Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SfPanelBrush"
                     Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SfAccentBrush"
                     Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SfTextBrush"
                     Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="SfTextMutedBrush"
                     Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="SfLineBrush"
                     Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="SfDangerBrush"
                     Color="#FF6B6B" />

</ResourceDictionary>
