<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource SfBgBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource SfTextBrush}"/>
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource SfPanelBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SfLineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="16"/>
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource SfTextMutedBrush}"/>
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{DynamicResource SfTextMutedBrush}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style Selector="TextBlock.stat">
    <Setter Property="FontSize" Value="40"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style Selector="Button.accent">
    <Setter Property="Foreground" Value="{DynamicResource SfBgBrush}"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="20,8"/>
  </Style>
  <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SfAccentBrush}"/>
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="CornerRadius" Value="0"/>
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SfTextBrush}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource SfBgBrush}"/>
  </Style>
</Styles>